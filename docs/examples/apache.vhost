#
# TLS in front of MCDashboard with a cache for public answers. Needs mod_ssl, mod_proxy, mod_proxy_http,
# mod_proxy_wstunnel, mod_cache and mod_cache_disk. Bind the plugin to 127.0.0.1 (server.host).
<VirtualHost *:443>
    ServerName mc.example.com
    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/mc.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/mc.example.com/privkey.pem

    # mod_proxy appends the client's address to X-Forwarded-For; the plugin uses that last hop (security.trusted-proxies).
    ProxyPass        /v1/live ws://127.0.0.1:1554/v1/live
    ProxyPass        /v1/     http://127.0.0.1:1553/v1/
    ProxyPassReverse /v1/     http://127.0.0.1:1553/v1/

    # Only responses the plugin marks public are stored; per-player answers are private.
    CacheEnable disk /v1/
    CacheRoot /var/cache/apache2/mcdashboard
    CacheIgnoreNoLastMod On
</VirtualHost>
