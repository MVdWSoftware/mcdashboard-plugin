<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mcdashboard</groupId>
    <artifactId>MCDashboard-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>MCDashboard-proxy-common</artifactId>
  <name>MCDashboard proxy common</name>
  <description>What the Velocity and BungeeCord plugins share: built-in network placeholders, optional federation of backend servers, proxy permissions and commands. No proxy API.</description>

  <properties>
    <!-- Reached 82.8% / 73.1%; target 100%. Gaps: ProxyCommands (link/revoke paths), HttpBackendFetcher (TLS pin trust manager, paging), Federation start/close, ProxyRuntime, ServerPinger. -->
    <jacoco.minimum.line>0.82</jacoco.minimum.line>
    <jacoco.minimum.branch>0.73</jacoco.minimum.branch>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.mcdashboard</groupId>
      <artifactId>MCDashboard-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The YAML library is the proxy's (BungeeCord) or shaded and relocated (Velocity). -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
      <scope>provided</scope>
    </dependency>
    <!-- Compiles the shared bStats chart helper; each proxy jar shades bstats-base plus its own adapter. -->
    <dependency>
      <groupId>org.bstats</groupId>
      <artifactId>bstats-base</artifactId>
      <version>${bstats.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
