<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mcdashboard</groupId>
    <artifactId>MCDashboard-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>MCDashboard-nukkit</artifactId>
  <name>MCDashboard PowerNukkitX</name>
  <description>The PowerNukkitX plugin for Bedrock servers: the hub's PlaceholderAPI as value source, PNX commands and permissions.</description>

  <properties>
    <!-- Adapters for the Nukkit API: they need a running server, so only the pure helpers are covered here. -->
    <jacoco.minimum.line>0.09</jacoco.minimum.line>
    <jacoco.minimum.branch>0.10</jacoco.minimum.branch>
    <!-- PowerNukkitX 3 runs on Java 21. -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <repositories>
    <repository>
      <id>PowerNukkitX-releases</id>
      <url>https://repo.powernukkitx.org/releases</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.mcdashboard</groupId>
      <artifactId>MCDashboard-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.powernukkitx</groupId>
      <artifactId>server</artifactId>
      <version>3.0.6-SNAPSHOT</version>
      <scope>provided</scope>
      <!-- The server brings its own libraries at runtime; only what this plugin names is added below. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.powernukkitx.placeholderapi</groupId>
      <artifactId>PlaceholderAPI</artifactId>
      <version>1.2.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>MCDashboard-Nukkit</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- The jar carries the core module's classes and default files; PowerNukkitX itself provides everything else. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>org.mcdashboard:MCDashboard-core</include>
                </includes>
              </artifactSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
