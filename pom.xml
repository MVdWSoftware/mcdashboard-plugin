<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.mcdashboard</groupId>
  <artifactId>MCDashboard-parent</artifactId>
  <packaging>pom</packaging>
  <version>1.0.0</version>
  <name>MCDashboard (parent)</name>
  <description>Publishes placeholder values as SenML over REST and a live feed for the MCDashboard app.</description>
  <url>https://mcdashboard.org</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0 or later</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>MVdW-Software</name>
    <url>https://mvdw-software.com</url>
  </organization>
  <developers>
    <developer>
      <name>Maxim Van de Wynckel</name>
      <organization>MVdW-Software</organization>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/MVdWSoftware/mcdashboard-plugin</url>
    <connection>scm:git:https://github.com/MVdWSoftware/mcdashboard-plugin.git</connection>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/MVdWSoftware/mcdashboard-plugin/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.14</jacoco.version>
    <!-- Pinned: the CI job runs `mvn sonar:sonar` when SONAR_HOST_URL is set (see .gitlab-ci.yml). -->
    <sonar.maven.plugin.version>5.1.0.4751</sonar.maven.plugin.version>
    <!-- bStats is shaded and relocated into the Spigot, BungeeCord and Velocity jars. -->
    <bstats.version>3.2.1</bstats.version>
    <!-- Sec-WebSocket-Accept is SHA-1 by RFC 6455, so java:S4790 does not apply to that one file. The Maven scanner
         reads its parameters from the pom, not from sonar-project.properties (that file is for the CLI), and its
         resourceKey is module-relative, hence the **/ pattern. -->
    <sonar.issue.ignore.multicriteria>e1</sonar.issue.ignore.multicriteria>
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S4790</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/WebSocketFrames.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <!-- Raised per module below; a module that reaches its target keeps the limit as a ratchet. -->
    <jacoco.minimum.line>0.00</jacoco.minimum.line>
    <jacoco.minimum.branch>0.00</jacoco.minimum.branch>
  </properties>

  <modules>
    <module>core</module>
    <module>spigot</module>
    <module>nukkit</module>
    <module>proxy-common</module>
    <module>velocity</module>
    <module>bungee</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.maven.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Coverage of every module: the agent runs with the tests, `report` writes target/site/jacoco and `check`
           fails the build below the limits each module sets (jacoco.minimum.line / jacoco.minimum.branch). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.minimum.line}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.minimum.branch}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Javadoc is part of the build: every public and protected type, field and method is documented, and every
           tag is valid and complete (@param matches the signature, @return on anything that returns). Doclint's
           `all` includes `missing`, so an undocumented member or record component fails the build too. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <id>javadoc-check</id>
            <phase>verify</phase>
            <goals><goal>javadoc</goal></goals>
            <configuration>
              <doclint>all</doclint>
              <failOnWarnings>true</failOnWarnings>
              <quiet>true</quiet>
              <!-- Doclint stops after 100 warnings, which would hide most findings in a module this size. -->
              <additionalOptions>
                <additionalOption>-Xmaxwarns</additionalOption>
                <additionalOption>10000</additionalOption>
              </additionalOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
