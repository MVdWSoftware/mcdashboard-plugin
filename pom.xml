<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026 MVdW-Software, SPDX-License-Identifier: AGPL-3.0-or-later -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.mcdashboard</groupId>
  <artifactId>MCDashboard-parent</artifactId>
  <packaging>pom</packaging>
  <version>1.0.0-SNAPSHOT</version>
  <name>MCDashboard (parent)</name>
  <description>Publishes placeholder values as SenML over REST and a live feed for the MinecraftDashboard app.</description>
  <url>https://mcdashboard.org</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0 or later</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>MVdW-Software</name>
    <url>https://mvdw-software.com</url>
  </organization>
  <developers>
    <developer>
      <name>Maxim Van de Wynckel</name>
      <organization>MVdW-Software</organization>
    </developer>
  </developers>
  <scm>
    <url>https://git.mvdw-software.com/mcdashboard/mcdashboard-plugin</url>
    <connection>scm:git:https://git.mvdw-software.com/mcdashboard/mcdashboard-plugin.git</connection>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://git.mvdw-software.com/mcdashboard/mcdashboard-plugin/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>core</module>
    <module>spigot</module>
    <module>nukkit</module>
    <module>proxy-common</module>
    <module>velocity</module>
    <module>bungee</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
